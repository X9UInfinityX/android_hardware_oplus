type hal_oplus_misc_aidl, domain;
binder_use(hal_oplus_misc_aidl)

type hal_oplus_misc_aidl_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_oplus_misc_aidl)

binder_call(vendor_hal_oplus_misc_client, vendor_hal_oplus_misc_server)
binder_call(vendor_hal_oplus_misc_server, vendor_hal_oplus_misc_client)

hal_client_domain(system_server, vendor_hal_oplus_misc)
hal_server_domain(hal_oplus_misc_aidl, vendor_hal_oplus_misc)

hal_attribute_service(vendor_hal_oplus_misc, hal_oplus_misc_aidl_service)

allow hal_oplus_misc_aidl fwk_stats_hwservice:hwservice_manager find;
allow hal_oplus_misc_aidl fwk_stats_service:service_manager find;

rw_dir_file(hal_oplus_misc_aidl, proc_cs_press_file)
